{
  "name": "watchfloor",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source OSINT common operating picture. Unclassified. Not a targeting product.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "live": "python3 scripts/fetch_live.py",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/memery33/watchfloor"
  },
  "license": "MIT",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@size-limit/file": "^14.2.0",
    "@types/leaflet": "^1.9.21",
    "size-limit": "^14.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "size-limit": [
    {
      "name": "initial JS",
      "path": "dist/assets/*.js",
      "limit": "95 KB",
      "gzip": true
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "14 KB",
      "gzip": true
    }
  ]
}
